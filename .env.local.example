# Local development .env example — safe defaults for working on your machine
DJANGO_SECRET_KEY=django-insecure-development-placeholder
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local Postgres (use your own local credentials, never a real one here)
DJANGO_DB_NAME=BetterSelf
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=replace-with-your-local-db-password
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Email (use mailtrap or local dev settings)
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Google OAuth (Sign in with Google) — get these from Google Cloud Console
# > APIs & Services > Credentials > OAuth 2.0 Client IDs. Never commit real
# values; this file is the example, .env is the real (gitignored) one.
CLIENT_ID=your-client-id.apps.googleusercontent.com
SECRET=your-google-client-secret

# M-Pesa / Daraja sandbox (Phase 4.1) — get your own consumer key/secret
# from https://developer.safaricom.co.ke. Shortcode/passkey below are
# Safaricom's published sandbox test values; replace only if Safaricom
# issues you different ones.
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_BASE_URL=https://your-ngrok-id.ngrok.io
