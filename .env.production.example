# Production .env example — DO NOT commit real secrets to source control
DJANGO_SECRET_KEY=replace-with-a-very-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Example Railway-style values — replace with your own, never real ones
DATABASE_NAME=railway
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-real-db-password
DATABASE_HOST=your-db-host.example.com
DATABASE_PORT=5432

# TLS / Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://your-production-domain.com

# Email
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Google OAuth (Sign in with Google) — from Google Cloud Console
CLIENT_ID=your-client-id.apps.googleusercontent.com
SECRET=your-google-client-secret

# Email verification is "optional" by default (app-wide) so people can sign
# up and use the app right away. Uncomment to require verified emails again
# once you want to use verification to gate access to certain features.
# ACCOUNT_EMAIL_VERIFICATION=mandatory

# M-Pesa / Daraja (Phase 4.1) — production credentials and shortcode,
# never the sandbox test passkey above.
MPESA_ENV=production
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=replace-with-production-consumer-key
MPESA_CONSUMER_SECRET=replace-with-production-consumer-secret
MPESA_SHORTCODE=replace-with-your-paybill-or-till
MPESA_PASSKEY=replace-with-production-passkey
MPESA_CALLBACK_BASE_URL=https://your-production-domain.com
